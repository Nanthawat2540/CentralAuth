@model LoginVm
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ca-page">

    <div class="ca-bg" aria-hidden="true">
        <div class="ca-blob ca-blob--1"></div>
        <div class="ca-blob ca-blob--2"></div>
        <div class="ca-blob ca-blob--3"></div>
    </div>

    <div class="ca-card">

        <div class="ca-brand">
            <div class="ca-logo">
                <span class="ca-logo-icon">🔐</span>
            </div>
            <h1 class="ca-title">PasTech Central</h1>
            <p class="ca-subtitle">Central Authentication</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="ca-alert" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i>
                @Model.Error
            </div>
        }

        <form method="post" action="/auth/login" autocomplete="off" class="ca-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="AppId"       value="@Model.AppId" />
            <input type="hidden" name="RedirectUri" value="@Model.RedirectUri" />

            <div class="ca-field">
                <label class="ca-label" for="login">Username หรือ Email</label>
                <input class="ca-input"
                       type="text"
                       id="login"
                       name="Login"
                       value="@Model.Login"
                       placeholder="กรอก username หรือ email"
                       autofocus
                       autocomplete="username" />
            </div>

            <div class="ca-field">
                <label class="ca-label" for="password">Password</label>
                <div class="ca-input-wrap">
                    <input class="ca-input"
                           type="password"
                           id="password"
                           name="Password"
                           placeholder="กรอก password"
                           autocomplete="current-password" />
                    <button type="button" class="ca-eye" aria-label="แสดง/ซ่อน password" onclick="togglePwd()">
                        <i class="bi bi-eye" id="eye-icon"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="ca-btn">
                <span>เข้าสู่ระบบ</span>
                <i class="bi bi-arrow-right ca-btn-arrow"></i>
            </button>
        </form>

        <div class="ca-footer">
            <span>© 2026 PasTech Co., Ltd.</span>
        </div>

    </div>

</div>

<script>
function togglePwd() {
    var inp  = document.getElementById('password');
    var icon = document.getElementById('eye-icon');
    if (inp.type === 'password') {
        inp.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        inp.type = 'password';
        icon.className = 'bi bi-eye';
    }
}
</script>
